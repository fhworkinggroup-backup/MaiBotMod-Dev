# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf
*.jar filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
gradle/wrapper/gradle-*.zip filter=lfs diff=lfs merge=lfs -text
gradle/wrapper/gradle-*/lib/*.jar filter=lfs diff=lfs merge=lfs -text
gradle/wrapper/gradle-8.1.1-bin.zip filter=lfs diff=lfs merge=lfs -text
gradle/wrapper/gradle-8.1.1/lib/kotlin-compiler-embeddable-1.8.10.jar filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
